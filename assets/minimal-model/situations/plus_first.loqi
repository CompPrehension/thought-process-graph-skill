// a + b * c, the student picks `+` while `*` is not evaluated yet.
obj a : Element { state = State:evaluated; }
obj b : Element { state = State:evaluated; }
obj c : Element { state = State:evaluated; }
obj mul : Operator { state = State:unevaluated; hasOperand(b); hasOperand(c); }
var X = obj plus : Operator { state = State:unevaluated; hasOperand(a); hasOperand(mul); }
